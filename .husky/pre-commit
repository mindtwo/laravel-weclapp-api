#!/usr/bin/env sh

# Husky runs hooks with `sh -e`, whatever the shebang says: POSIX only.

# Husky owns core.hooksPath once `npm ci` has run, so GrumPHP's own hook in
# .git/hooks never fires; call it here the way that hook does, with the staged
# diff on stdin, so the linter still runs on every commit.
DIFF=$(git -c diff.mnemonicprefix=false -c diff.noprefix=false --no-pager diff --raw -r -p -m -M --full-index --no-color --staged | cat)

export GRUMPHP_GIT_WORKING_DIR="$(git rev-parse --show-toplevel)"

printf "%s\n" "${DIFF}" | vendor/bin/grumphp git:pre-commit --skip-success-output
