# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Everything below is excluded from the composer dist archive. The rule: a
# consumer receives the runtime (src, config, database, resources), the licence
# and the README — nothing else. Development tooling, CI, tests and agent
# configuration stay in the repository.
#
# Verify after changing this file, rather than reading it:
#     git archive HEAD | tar -t | awk -F/ '{print $1}' | sort -u
#
# `resources/` is currently only an empty views directory and the provider does
# not declare hasViews(). It still ships on purpose: an export-ignore left in
# place after someone adds a view would drop it from the release silently, which
# is a worse failure than one empty directory.

# Agent and editor tooling
/.ai                    export-ignore
/.claude                export-ignore
/.mcp.json              export-ignore
/boost.json             export-ignore
/.editorconfig          export-ignore

# CI, hooks and release automation
/.github                export-ignore
/.husky                 export-ignore
/commitlint.config.cjs  export-ignore
/grumphp.yml            export-ignore
/release.config.js      export-ignore
/release.js             export-ignore

# Node toolchain — the package itself ships no JS
/.nvmrc                 export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore

# Static analysis and formatting
/phpstan.neon.dist      export-ignore
/phpstan-baseline.neon  export-ignore
/pint.json              export-ignore

# Tests and their harness
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/testbench.yaml         export-ignore
/tests                  export-ignore
/workbench              export-ignore
/.env.example           export-ignore
/bin                    export-ignore

# Repository documentation and governance. `docs/` also holds the OpenAPI spec:
# leaving it out is deliberate, and SpecReader::available() degrades to not
# registering weclapp:make-mirror when the spec is absent.
/docs                   export-ignore
/CHANGELOG.md           export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/CONTRIBUTORS           export-ignore

# Git metadata
/.gitattributes         export-ignore
/.gitignore             export-ignore

# Composer never reads a dependency's lock file
/composer.lock          export-ignore
