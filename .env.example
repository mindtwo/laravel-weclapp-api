# Weclapp instance URL (including the API version segment) and personal API
# token. Create a token under "My settings" in Weclapp.
MINDTWO_WECLAPP_URL="https://your-tenant.weclapp.com/webapp/api/v2/"
MINDTWO_WECLAPP_API_KEY=

# Optional — shown with their defaults. Omit a line, or leave it blank, to use
# the default.
# MINDTWO_WECLAPP_PAGE_SIZE=1000
# MINDTWO_WECLAPP_TIMEZONE=UTC
# Blank: off on local/testing, on everywhere else.
# MINDTWO_WECLAPP_WRITES_ENABLED=
# MINDTWO_WECLAPP_VISIBLE_TAG=
# MINDTWO_WECLAPP_HTTP_TIMEOUT=60
# MINDTWO_WECLAPP_HTTP_CONNECT_TIMEOUT=10
# MINDTWO_WECLAPP_HTTP_RETRY_TIMES=3
# MINDTWO_WECLAPP_HTTP_RETRY_SLEEP=500
# MINDTWO_WECLAPP_QUEUE_CONNECTION=
# MINDTWO_WECLAPP_RATE_LIMIT_PER_MINUTE=100
# MINDTWO_WECLAPP_LOG_EVENTS=false
# MINDTWO_WECLAPP_LOG_LEVEL=info
# MINDTWO_WECLAPP_LOG_CHANNEL=
# MINDTWO_WECLAPP_LOG_INCLUDE_PAYLOAD=false

# Release/Deploy
GITHUB_URL=
